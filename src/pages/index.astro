---
const offerings = [
  {
    title: 'Project One',
    description:
      'Placeholder description for Project One. Short paragraph describing the engagement, the audience, and the outcome. Replace this with the real copy.',
    price: 'Starting at $5,000 / engagement',
  },
  {
    title: 'Project Two',
    description:
      'Placeholder description for Project Two. Short paragraph describing the engagement, the audience, and the outcome. Replace this with the real copy.',
    price: 'Starting at $7,500 / engagement',
  },
  {
    title: 'Project Three',
    description:
      'Placeholder description for Project Three. Short paragraph describing the engagement, the audience, and the outcome. Replace this with the real copy.',
    price: 'Starting at $10,000 / engagement',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>[Business Name] — Consulting</title>
    <meta
      name="description"
      content="Placeholder description for the business. Replace this with real copy."
    />
  </head>
  <body>
    <header>
      <div class="logo">[Business Name]</div>
    </header>

    <main>
      <section class="hero">
        <h1>[Business Name]</h1>
        <p class="tagline">
          Placeholder tagline. Replace this with the real one-line value proposition.
        </p>
      </section>

      <section class="offerings" aria-labelledby="offerings-heading">
        <h2 id="offerings-heading">Offerings</h2>
        <div class="card-grid">
          {offerings.map((o) => (
            <article class="card">
              <h3>{o.title}</h3>
              <p>{o.description}</p>
              <p class="price">{o.price}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="cta" id="contact">
        <h2>Get in touch</h2>
        <p>
          Placeholder text describing how to reach out. Replace with a real form,
          email, or scheduling link.
        </p>
        <p>
          <a href="mailto:[email protected]">[email protected]</a>
        </p>
      </section>
    </main>

    <footer>
      <p>
        &copy; <span id="year"></span> [Business Name]. All rights reserved.
      </p>
    </footer>

    <style>
      :root {
        color-scheme: light dark;
        --fg: #111;
        --bg: #fff;
        --muted: #555;
        --accent: #1f4d7a;
        --card: #f6f6f6;
        --border: #e2e2e2;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #f3f3f3;
          --bg: #111;
          --muted: #aaa;
          --card: #1a1a1a;
          --border: #2a2a2a;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        line-height: 1.5;
        color: var(--fg);
        background: var(--bg);
      }
      header {
        padding: 1.25rem 2rem;
        border-bottom: 1px solid var(--border);
      }
      header .logo { font-weight: 600; }
      main {
        max-width: 64rem;
        margin: 0 auto;
        padding: 2rem;
      }
      .hero {
        padding: 3rem 0;
        border-bottom: 1px solid var(--border);
      }
      .hero h1 { margin: 0 0 0.5rem 0; font-size: 2.25rem; }
      .tagline { margin: 0; color: var(--muted); max-width: 36rem; }
      .offerings { padding: 3rem 0; }
      .offerings h2 { margin: 0 0 1.5rem 0; }
      .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        gap: 1.25rem;
      }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .card h3 { margin: 0; }
      .card p { margin: 0; }
      .price { margin-top: auto; font-weight: 600; color: var(--accent); }
      .cta {
        padding: 3rem 0;
        border-top: 1px solid var(--border);
      }
      .cta h2 { margin: 0 0 0.75rem 0; }
      .cta a { color: var(--accent); }
      footer {
        padding: 1.5rem 2rem;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.875rem;
      }
    </style>

    <script>
      document.getElementById('year').textContent = new Date().getFullYear();
    </script>
  </body>
</html>
